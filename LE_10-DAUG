
#include <stdio.h>

int main() {
    FILE *file;
    char note[200];
    int numberOfNotes;
    int i;

    // Step 1: Create the file and write initial notes
    file = fopen("notes.txt", "w");

    if (file == NULL) {
        printf("Error creating file!\n");
        return 1;
    }

    printf("Writing Notes File:\n");
    printf("How many notes do you want to record? ");
    scanf("%d", &numberOfNotes);

    getchar(); // Clear newline from input buffer

    for (i = 1; i <= numberOfNotes; i++) {
        printf("\nNote %d: ", i);

        fgets(note, sizeof(note), stdin);
        fprintf(file, "%s", note);
    }

    fclose(file);

    printf("\nInitial notes saved successfully.\n");

    // Step 2: Append one additional note
    file = fopen("notes.txt", "a");

    if (file == NULL) {
        printf("Error opening file for appending!\n");
        return 1;
    }

    printf("\nEnter one additional note:\n");
    fgets(note, sizeof(note), stdin);

    fprintf(file, "%s", note);

    fclose(file);

    printf("\nNew note added successfully.\n");

    // Step 3: Read and display all saved notes
    file = fopen("notes.txt", "r");

    if (file == NULL) {
        printf("Error opening file for reading!\n");
        return 1;
    }

    printf("\nReading Saved Notes:\n");

    i = 1;

    while (fgets(note, sizeof(note), file) != NULL) {
        printf("%d. %s", i, note);
        i++;
    }

    fclose(file);

    return 0;
}
