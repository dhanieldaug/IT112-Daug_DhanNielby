#include <stdio.h>

int main() {
    float balance = 500.00; // Initial balance
    float amount;
    int choice;

    do {
        printf("BSIT BANK\n");
        printf("Please Select your Transaction\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Your current balance: P%.2f\n\n", balance);
                break;
                
            case 2:
                printf("Enter amount to deposit: ");
                scanf("%f", &amount);
                balance += amount;
                printf("P%.2f deposited successfully!\n\n", amount);
                break;
                
            case 3:
                printf("Enter amount to withdraw: ");
                scanf("%f", &amount);
                // Check if remaining balance drops below P100.00
                if ((balance - amount) < 100.00) {
                    printf("Withdrawal denied! You must maintain at least P100.00 in your account.\n\n");
                } else {
                    balance -= amount;
                    printf("You withdrew P%.2f successfully!\n\n", amount);
                }
                break;
                
            case 4:
                // Exit choice ends the loop
                break;
                
            default:
                printf("Invalid choice! Please select between 1 and 4.\n\n");
        }
    } while (choice != 4);

    return 0;
}